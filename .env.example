APP_NAME=WeatherFusion India API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://weatherfusion:weatherfusion@localhost:55432/weatherfusion
CORS_ORIGINS=["http://localhost:5173"]
VERIFICATION_PROVIDER=operational
VERIFICATION_MODEL_ARTIFACT_PATH=
VERIFICATION_ML_MINIMUM_MARGIN=0.0
GEOSPATIAL_PROVIDER=postgis
DEMO_MODE=false
LOG_LEVEL=INFO

POSTGRES_DB=weatherfusion
POSTGRES_USER=weatherfusion
POSTGRES_PASSWORD=weatherfusion
VITE_API_BASE_URL=http://localhost:8000
# Optional Mappls browser token. Restrict it to the deployed frontend domains in Mappls.
VITE_MAPPLS_ACCESS_TOKEN=
WEATHER_CONNECTOR_ENABLED=true
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CONNECTOR_TIMEOUT_SECONDS=8
WEATHER_CACHE_MAX_AGE_MINUTES=1440
WEATHER_DEFAULT_LOCATION_NAME=Indore
WEATHER_DEFAULT_LATITUDE=22.7196
WEATHER_DEFAULT_LONGITUDE=75.8577
WEATHER_TIMEZONE=Asia/Kolkata
WEATHER_FORECAST_DAYS=2
EVIDENCE_SOURCE_RELIABILITY_WEIGHT=0.25
EVIDENCE_INDEPENDENT_CORROBORATION_WEIGHT=0.25
EVIDENCE_OFFICIAL_OBSERVATION_WEIGHT=0.20
EVIDENCE_LOCATION_TIME_WEIGHT=0.15
EVIDENCE_VALIDATED_ML_WEIGHT=0.15
EVIDENCE_MINIMUM_COVERAGE=0.60
EVIDENCE_CORROBORATION_RADIUS_METERS=20000
EVIDENCE_CORROBORATION_WINDOW_HOURS=24
EVIDENCE_CORROBORATION_SOURCES_FOR_FULL_SUPPORT=2
EVIDENCE_LOCATION_TIME_MAX_AGE_HOURS=720
EVIDENCE_LOCATION_TIME_FUTURE_TOLERANCE_MINUTES=120
